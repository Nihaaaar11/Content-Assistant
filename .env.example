# ---------------------------------------------------------------------------
# grok-hindsight-agent — copy to .env and fill in your values
# ---------------------------------------------------------------------------

# --- xAI (Grok) — powers the chat agent AND Hindsight's memory processing ---
XAI_API_KEY=xai-...
# Chat/agent model. Check https://x.ai/api for current IDs.
GROK_MODEL=grok-4-fast

# --- Hindsight memory server (launched by start.sh on port 8888) ---
HINDSIGHT_URL=http://localhost:8888
# Must match the bank id used by the backend for brands (keep default).
HINDSIGHT_BANK_PREFIX=brand_

# --- FastAPI backend (port 8000) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# SQLite file for structured metric time-series
DATABASE_URL=sqlite:///./data/agent.db
# Frontend URL (used in absolute links inside reports)
FRONTEND_URL=http://localhost:3000

# --- Automated collection (APScheduler) ---
# How often to poll connected platforms for new posts + fresh metrics
COLLECTION_INTERVAL_HOURS=6
# Hour of day (0-23, server local time) for the deeper daily digest
DIGEST_HOUR=7
# Auto-start the collection scheduler when the backend boots
SCHEDULER_ENABLED=true

# --- YouTube Data API v3 (https://console.cloud.google.com) ---
# OAuth client for your OWN channel (desktop app client):
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Leave YOUTUBE_REFRESH_TOKEN empty until you run the OAuth helper:
#   python -m connectors.youtube_auth
YOUTUBE_REFRESH_TOKEN=
# Free API key fallback (read-only public data, no private metrics):
YOUTUBE_API_KEY=

# --- Instagram Graph API (via Meta for Developers) ---
# Requires a Meta app with instagram_basic + instagram_manage_insights
# and an Instagram Business/Creator account linked to a Facebook Page.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# --- Frontend (frontend/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
